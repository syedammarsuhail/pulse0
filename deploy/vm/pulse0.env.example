# Install as /etc/pulse0/pulse0.env (chmod 600, owner root). Used by pulse0.service.
PULSE0_HOST=0.0.0.0
PULSE0_PORT=4318
PULSE0_DB=/var/lib/pulse0/pulse0.db
PULSE0_TOKEN=change-me-use-openssl-rand-hex-24
PULSE0_RETENTION_HOURS=72
# Optional: use Postgres instead of SQLite
# PULSE0_DATABASE_URL=postgresql://user:password@db-host:5432/pulse0?sslmode=require
